# คัดลอกไฟล์นี้เป็น .env.local แล้วกรอกค่าจริงจาก Supabase Project Settings → API
# ห้าม commit .env.local ลง git เด็ดขาด (.gitignore กันไว้แล้วด้วย pattern .env*)

NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# ใช้เฉพาะฝั่งเซิร์ฟเวอร์ (Edge Function / เชิญผู้ใช้ / script migration) ห้ามใส่ prefix NEXT_PUBLIC_
# เพราะจะถูก bundle เข้า client-side JS ทันที — service_role key bypass RLS ทั้งหมด
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# URL ของเว็บที่ใช้จริง (สำหรับลิงก์ในอีเมลเชิญผู้ใช้)
# บนเครื่อง dev ใช้ localhost — บน VPS ต้องเป็นโดเมนจริงที่ Nginx ชี้มา
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ข้อมูลสำหรับการ Deploy ขึ้น VPS ผ่าน SSH (สำหรับรัน scripts/deploy-vps.mjs)
# VPS_HOST=your-vps-ip-or-domain
# VPS_PORT=22
# VPS_USER=root
# VPS_SSH_KEY=C:/Users/YourUser/.ssh/id_rsa   # หรือปล่อยว่างถ้าใช้ SSH Agent / default key
# VPS_PATH=/path/to/RRS                      # โฟลเดอร์โปรเจกต์บน VPS
# VPS_PM2_APP=sneakercare                    # ชื่อ process ใน PM2
